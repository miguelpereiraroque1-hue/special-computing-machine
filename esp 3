local function toggle(parent,name,key)
    local function text()
        return name.." : "..(Config[key] and "ON" or "OFF")
    end

    local b = button(parent,text(),function(self)
        Config[key] = not Config[key]
        self.Text = text()
    end)

    return b
end

local function number(parent,name,key,step,min,max)
    button(parent,name.." : "..Config[key],function(self)
        local value = Config[key]+step
        if value > max then value = min end
        Config[key] = math.round(value*100)/100
        self.Text = name.." : "..Config[key]
    end)
end

