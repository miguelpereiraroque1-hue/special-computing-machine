local function new(class, parent, props)
    local o = Instance.new(class)

    for k, v in pairs(props or {}) do
        o[k] = v
    end

    o.Parent = parent
    return o
end

local function round(o, n)
    new("UICorner", o, {
        CornerRadius = UDim.new(0, n)
    })
end

