-- OPTIMIZED UPDATE LOOP
local espAccumulator = 0
local aimAccumulator = 0
local aimTarget = nil

RunService:BindToRenderStep(
    "OptimizedESP_Aim",
    Enum.RenderPriority.Camera.Value+1,
    function(dt)
        Camera = workspace.CurrentCamera
        if not Camera then return end

        espAccumulator += dt

        if espAccumulator >= Config.ESPInterval then
            espAccumulator = 0

            for id,data in pairs(targets) do
                updateESP(id,data)
            end
        end

        local diameter = Config.FOV*2

        fov.Visible = Config.ShowFOV
        fov.Size = UDim2.fromOffset(diameter,diameter)
        fov.Position = UDim2.fromOffset(
            Camera.ViewportSize.X/2-Config.FOV,
            Camera.ViewportSize.Y/2-Config.FOV
        )

        if not holding then
            aimTarget = nil
            aimAccumulator = 0
            return
        end

        aimAccumulator += dt

        if aimAccumulator >= 1/30 then
            aimAccumulator = 0
            aimTarget = findTarget()
        end

        if aimTarget and aimTarget.Parent then
            local prediction =
                aimTarget.Position
                + aimTarget.AssemblyLinearVelocity*Config.Prediction

            local desired = CFrame.lookAt(
                Camera.CFrame.Position,
                prediction
            )

            local smooth = 1-math.pow(
                1-math.clamp(Config.Smoothness,0.01,1),
                dt*60
            )

            Camera.CFrame = Camera.CFrame:Lerp(
                desired,
                smooth
            )
        end
    end
)

