local function make(class, parent, props)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local function corner(parent, radius)
    make("UICorner", parent, {
        CornerRadius = UDim.new(0, radius)
    })
end

local function label(parent, text, size, color)
    return make("TextLabel", parent, {
        BackgroundTransparency = 1,
        Text = text,
        Font = Enum.Font.GothamMedium,
        TextSize = size or 12,
        TextColor3 = color or Color3.new(1, 1, 1),
        TextXAlignment = Enum.TextXAlignment.Left,
        Size = UDim2.new(1, -12, 0, 23)
    })
end

local function line(parent)
    local f = make("Frame", parent, {
        BorderSizePixel = 0,
        BackgroundColor3 = S.ESP.Color,
        BackgroundTransparency = S.ESP.Transparency,
        Visible = false,
        Size = UDim2.fromOffset(1, S.ESP.Thickness)
    })
    return f
end

local function setLine(f, a, b, color)
    local delta = b - a
    local length = delta.Magnitude

    f.Position = UDim2.fromOffset(a.X, a.Y)
    f.Size = UDim2.fromOffset(length, S.ESP.Thickness)
    f.Rotation = math.deg(math.atan2(delta.Y, delta.X))
    f.BackgroundColor3 = color or S.ESP.Color
    f.BackgroundTransparency = S.ESP.Transparency
    f.Visible = true
end

local function project(pos)
    local p, visible = Camera:WorldToViewportPoint(pos)
    return Vector2.new(p.X, p.Y), visible and p.Z > 0
end

local function humanoidOf(char)
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function rootOf(char)
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function headOf(char)
    return char and char:FindFirstChild("Head")
end

local function alive(char)
    local h = humanoidOf(char)
    return h and h.Health > 0
end

local function getWeapon(char)
    if not char then return "None" end
    local tool = char:FindFirstChildOfClass("Tool")
    return tool and tool.Name or "None"
end

local function skeletonPairs(char)
    if char:FindFirstChild("UpperTorso") then
        return {
            {"Head", "UpperTorso"},
            {"UpperTorso", "LowerTorso"},
            {"UpperTorso", "LeftUpperArm"},
            {"LeftUpperArm", "LeftLowerArm"},
            {"LeftLowerArm", "LeftHand"},
            {"UpperTorso", "RightUpperArm"},
            {"RightUpperArm", "RightLowerArm"},
            {"RightLowerArm", "RightHand"},
            {"LowerTorso", "LeftUpperLeg"},
            {"LeftUpperLeg", "LeftLowerLeg"},
            {"LeftLowerLeg", "LeftFoot"},
            {"LowerTorso", "RightUpperLeg"},
            {"RightUpperLeg", "RightLowerLeg"},
            {"RightLowerLeg", "RightFoot"}
        }
    end

    return {
        {"Head", "Torso"},
        {"Torso", "Left Arm"},
        {"Torso", "Right Arm"},
        {"Torso", "Left Leg"},
        {"Torso", "Right Leg"}
    }
end

-- Cached visual objects
local visuals = {}

local function removeVisual(id)
    local v = visuals[id]
    if not v then return end

    for _, obj in ipairs(v.Objects) do
        obj:Destroy()
    end

    visuals[id] = nil
end

local function createVisual(id, char)
    removeVisual(id)

    local v = {
        Character = char,
        Objects = {},
        Lines = {},
        Bones = {}
    }

    local function track(obj)
        table.insert(v.Objects, obj)
        return obj
    end

    v.Container = track(make("Frame", overlay, {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1)
    }))

    for i = 1, 4 do
        v.Lines[i] = line(v.Container)
    end

    for i = 1, 8 do
        v.Lines[4 + i] = line(v.Container)
    end

    v.Tracer = line(v.Container)

    for i = 1, 14 do
        v.Bones[i] = line(v.Container)
    end

    v.Dot = make("Frame", v.Container, {
        BackgroundColor3 = S.ESP.Color,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(7, 7),
        Visible = false
    })
    corner(v.Dot, 20)

    v.Info = make("TextLabel", v.Container, {
        BackgroundTransparency = 1,
        TextColor3 = Color3.new(1, 1, 1),
        TextStrokeTransparency = 0.2,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        Text = "",
        TextWrapped = false,
        Visible = false,
        Size = UDim2.fromOffset(210, 54)
    })

    v.HealthBack = make("Frame", v.Container, {
        BackgroundColor3 = Color3.fromRGB(30, 30, 30),
        BorderSizePixel = 0,
        Visible = false
    })

    v.HealthFill = make("Frame", v.HealthBack, {
        BackgroundColor3 = Color3.fromRGB(0, 230, 90),
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1)
    })

    v.Highlight = track(make("Highlight", char, {
        Name = "TestESPHighlight",
        FillColor = S.ESP.Color,
        OutlineColor = S.ESP.Color,
        FillTransparency = 0.65,
        OutlineTransparency = 0,
        Enabled = false,
        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    }))

    local root = rootOf(char)
    if root then
        v.Box3D = track(make("BoxHandleAdornment", root, {
            Name = "TestESPBox3D",
            Adornee = root,
            AlwaysOnTop = true,
            Color3 = S.ESP.Color,
            Transparency = 0.6,
            Size = Vector3.new(4, 6, 2),
            Visible = false
        }))
    end

    visuals[id] = v
    return v
end

local function clear2D(v)
    for _, l in ipairs(v.Lines) do
        l.Visible = false
    end
    for _, l in ipairs(v.Bones) do
        l.Visible = false
    end
    v.Tracer.Visible = false
    v.Dot.Visible = false
    v.Info.Visible = false
    v.HealthBack.Visible = false
end

local function drawRect(v, x, y, w, h, color)
    local points = {
        Vector2.new(x, y),
        Vector2.new(x + w, y),
        Vector2.new(x + w, y + h),
        Vector2.new(x, y + h)
    }

    for i = 1, 4 do
        setLine(
            v.Lines[i],
            points[i],
            points[i % 4 + 1],
            color
        )
    end
end

local function drawCorners(v, x, y, w, h, color)
    local n = math.min(w, h) * 0.24
    local segments = {
        {x, y, x+n, y},
        {x, y, x, y+n},
        {x+w, y, x+w-n, y},
        {x+w, y, x+w, y+n},
        {x, y+h, x+n, y+h},
        {x, y+h, x, y+h-n},
        {x+w, y+h, x+w-n, y+h},
        {x+w, y+h, x+w, y+h-n}
    }

    for i, seg in ipairs(segments) do
        setLine(
            v.Lines[i+4],
            Vector2.new(seg[1], seg[2]),
            Vector2.new(seg[3], seg[4]),
            color
        )
    end
end

local function characterBounds(char)
    local cf, size = char:GetBoundingBox()
    local half = size * 0.5

    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge

    for x = -1, 1, 2 do
        for y = -1, 1, 2 do
            for z = -1, 1, 2 do
                local p, on = project(
                    cf:PointToWorldSpace(
                        Vector3.new(
                            half.X*x,
                            half.Y*y,
                            half.Z*z
                        )
                    )
                )

                if not on then return nil end

                minX = math.min(minX, p.X)
                minY = math.min(minY, p.Y)
                maxX = math.max(maxX, p.X)
                maxY = math.max(maxY, p.Y)
            end
        end
    end

    return minX, minY, maxX-minX, maxY-minY
end

local function updateESP(id, char, displayName)
    local v = visuals[id]

    if not v or v.Character ~= char then
        v = createVisual(id, char)
    end

    clear2D(v)

    local root = rootOf(char)
    local head = headOf(char)
    local hum = humanoidOf(char)

    if not root or not head or not hum then
        v.Highlight.Enabled = false
        if v.Box3D then v.Box3D.Visible = false end
        return
    end

    local distance = (
        Camera.CFrame.Position - root.Position
    ).Magnitude

    local valid = S.ESP.Enabled
        and hum.Health > 0
        and distance <= S.ESP.MaxDistance

    v.Highlight.Enabled = valid and S.ESP.Chams

    v.Highlight.FillColor = S.ESP.Color
    v.Highlight.OutlineColor = S.ESP.Color

    v.Highlight.DepthMode =
        S.ESP.ThroughWalls
        and Enum.HighlightDepthMode.AlwaysOnTop
        or Enum.HighlightDepthMode.Occluded

    if v.Box3D then
        v.Box3D.Visible = valid and S.ESP.Box3D
        v.Box3D.Color3 = S.ESP.Color
        v.Box3D.AlwaysOnTop = S.ESP.ThroughWalls
    end

    if not valid then return end

    local root2D, onScreen = project(root.Position)
    if not onScreen then return end

    local x, y, w, h = characterBounds(char)
    if not x then return end

    local color = S.ESP.Color

    if S.ESP.Box2D then
        drawRect(v, x, y, w, h, color)
    end

    if S.ESP.CornerBox then
        drawCorners(v, x, y, w, h, color)
    end

    if S.ESP.Tracers then
        setLine(
            v.Tracer,
            Vector2.new(
                Camera.ViewportSize.X/2,
                Camera.ViewportSize.Y
            ),
            root2D,
            color
        )
    end

    if S.ESP.HeadDot then
        local hp, visible = project(head.Position)
        v.Dot.Visible = visible
        v.Dot.Position = UDim2.fromOffset(hp.X-3, hp.Y-3)
        v.Dot.BackgroundColor3 = color
    end

    if S.ESP.Skeleton then
        local pairsList = skeletonPairs(char)

        for i, pair in ipairs(pairsList) do
            local a = char:FindFirstChild(pair[1])
            local b = char:FindFirstChild(pair[2])

            if a and b and v.Bones[i] then
                local pa, va = project(a.Position)
                local pb, vb = project(b.Position)

                if va and vb then
                    setLine(v.Bones[i], pa, pb, color)
                end
            end
        end
    end

    local info = {}

    if S.ESP.Names then
        table.insert(info, displayName)
    end

    if S.ESP.Distance then
        table.insert(info, math.floor(distance).." studs")
    end

    if S.ESP.Weapon then
        table.insert(info, getWeapon(char))
    end

    if #info > 0 then
        v.Info.Text = table.concat(info, "\n")
        v.Info.Position = UDim2.fromOffset(
            x+w/2-105,
            y-57
        )
        v.Info.Visible = true
    end

    if S.ESP.Health then
        local ratio = math.clamp(
            hum.Health/math.max(hum.MaxHealth, 1),
            0,
            1
        )

        v.HealthBack.Position = UDim2.fromOffset(x-8, y)
        v.HealthBack.Size = UDim2.fromOffset(4, h)
        v.HealthBack.Visible = true

        v.HealthFill.Position = UDim2.fromScale(0, 1-ratio)
        v.HealthFill.Size = UDim2.fromScale(1, ratio)
        v.HealthFill.BackgroundColor3 =
            Color3.fromRGB(
                math.floor(255*(1-ratio)),
                math.floor(255*ratio),
                40
            )
    end
end

-- Target collection
-- Players and NPCs in the current authorized experience

local function getTargets()
    local result = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            table.insert(result, {
                Id = "P_"..player.UserId,
                Character = player.Character,
                Name = player.DisplayName
            })
        end
    end

    -- NPCs tagged with the attribute TestTarget
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model")
            and obj:GetAttribute("TestTarget") == true
            and humanoidOf(obj)
        then
            table.insert(result, {
                Id = obj,
                Character = obj,
                Name = obj.Name
            })
        end
    end

    return result
end

local function visibleTarget(part, char)
    if not S.Aim.VisibilityCheck then
        return true
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {
        LocalPlayer.Character
    }

    local origin = Camera.CFrame.Position
    local direction = part.Position-origin

    local hit = workspace:Raycast(
        origin,
        direction,
        params
    )

    return not hit or hit.Instance:IsDescendantOf(char)
end

local lockedTarget = nil

local function targetValid(char)
    if not char then return false end

    local hum = humanoidOf(char)
    local root = rootOf(char)
    local part = char:FindFirstChild(S.Aim.TargetPart)
        or headOf(char)
        or root

    if not hum or not root or not part then
        return false
    end

    if S.Aim.IgnoreDead and hum.Health <= 0 then
        return false
    end

    if (
        Camera.CFrame.Position-root.Position
    ).Magnitude > S.Aim.MaxDistance then
        return false
    end

    local pos, on = project(part.Position)
    if not on then return false end

    local center = Camera.ViewportSize/2
    local center2D = Vector2.new(center.X, center.Y)

    if (pos-center2D).Magnitude > S.Aim.FOV then
        return false
    end

    if not visibleTarget(part, char) then
        return false
    end

    return true, part
end

local function closestTarget(targets)
    if S.Aim.TargetLock and lockedTarget then
        local ok, part = targetValid(lockedTarget)
        if ok then return part end
    end

    local best = nil
    local smallest = math.huge
    local center = Camera.ViewportSize/2
    local center2D = Vector2.new(center.X, center.Y)

    for _, entry in ipairs(targets) do
        local ok, part = targetValid(entry.Character)

        if ok then
            local pos = project(part.Position)
            local diff = (pos-center2D).Magnitude

            if diff < smallest then
                smallest = diff
                best = part
                lockedTarget = entry.Character
            end
        end
    end

    if not best then
        lockedTarget = nil
    end

    return best
end

local function aimAt(part, dt)
    local predicted = part.Position
        + part.AssemblyLinearVelocity*S.Aim.Prediction

    local desired = CFrame.lookAt(
        Camera.CFrame.Position,
        predicted
    )

    local alpha = 1-math.pow(
        1-math.clamp(S.Aim.Smoothness, 0.01, 1),
        dt*60
    )

    Camera.CFrame = Camera.CFrame:Lerp(desired, alpha)
end

