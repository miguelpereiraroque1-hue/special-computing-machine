local function button(parent, text, callback)
    local b = make("TextButton", parent, {
        BackgroundColor3 = Color3.fromRGB(38, 39, 55),
        BorderSizePixel = 0,
        TextColor3 = Color3.new(1, 1, 1),
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        Text = text,
        Size = UDim2.new(1, -5, 0, 29)
    })
    corner(b, 6)

    b.MouseButton1Click:Connect(function()
        callback(b)
    end)

    return b
end

local function toggle(parent, text, tbl, key)
    local function caption()
        return text.." : "..(tbl[key] and "ON" or "OFF")
    end

    local b = button(parent, caption(), function(self)
        tbl[key] = not tbl[key]
        self.Text = caption()
        self.BackgroundColor3 = tbl[key]
            and Color3.fromRGB(54, 65, 91)
            or Color3.fromRGB(38, 39, 55)
    end)

    b.BackgroundColor3 = tbl[key]
        and Color3.fromRGB(54, 65, 91)
        or Color3.fromRGB(38, 39, 55)
end

local function adjust(parent, text, tbl, key, step, low, high)
    local b = button(parent, "", function(self)
        tbl[key] = math.clamp(
            tbl[key]+step,
            low,
            high
        )

        if tbl[key] >= high then
            tbl[key] = low
        end

        self.Text = text.." : "..string.format("%.2f", tbl[key])
    end)

    b.Text = text.." : "..string.format("%.2f", tbl[key])
end

local function selectTab(name)
