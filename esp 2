    end

    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        S.Aim.Holding = false
        lockedTarget = nil
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging
        and input.UserInputType == Enum.UserInputType.MouseMovement
    then
        local delta = input.Position-dragStart

        menu.Position = UDim2.new(
            menuStart.X.Scale,
            menuStart.X.Offset+delta.X,
            menuStart.Y.Scale,
            menuStart.Y.Offset+delta.Y
        )
    end
end)

UIS.InputBegan:Connect(function(input, processed)
    if processed then return end

    if input.KeyCode == S.UI.MenuKey then
        S.UI.Visible = not S.UI.Visible
        menu.Visible = S.UI.Visible
    end

    if input.KeyCode == S.UI.AimKey then
        S.Aim.Enabled = not S.Aim.Enabled
        lockedTarget = nil
    end

    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        S.Aim.Holding = true
    end
end)

selectTab("ESP")

-- Cached NPC scan (avoid workspace scans each frame)
local targets = {}
local scanTimer = 0

local function refreshTargets()
    targets = getTargets()

    local active = {}

    for _, t in ipairs(targets) do
        active[t.Id] = true
    end

    local obsolete = {}

    for id in pairs(visuals) do
        if not active[id] then
            table.insert(obsolete, id)
        end
    end

    for _, id in ipairs(obsolete) do
        removeVisual(id)
    end
end

refreshTargets()

-- Main render loop
local connection
connection = RunService.RenderStepped:Connect(function(dt)
    Camera = workspace.CurrentCamera
    if not Camera then return end

    scanTimer += dt

    if scanTimer >= 0.5 then
        scanTimer = 0
        refreshTargets()
    end

    for _, entry in ipairs(targets) do
        if entry.Character and entry.Character.Parent then
            updateESP(
                entry.Id,
                entry.Character,
                entry.Name
            )
        end
    end

    local diameter = S.Aim.FOV*2

    fovCircle.Visible = S.Aim.ShowFOV
        and S.Aim.Enabled

    fovCircle.Size = UDim2.fromOffset(diameter, diameter)

    fovCircle.Position = UDim2.fromOffset(
        Camera.ViewportSize.X/2-S.Aim.FOV,
        Camera.ViewportSize.Y/2-S.Aim.FOV
    )

    if S.Aim.Enabled and S.Aim.Holding then
        local target = closestTarget(targets)

        if target then
            aimAt(target, dt)
        end
    end
end)

