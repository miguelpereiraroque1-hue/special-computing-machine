-- 🔧 CHARACTER ADAPTER (Supports both R6 and R15 dynamically)
function GetBoneMap(character)
	local rootPart=character:FindFirstChild("HumanoidRootPart");
	if not rootPart then return nil end;

	local map={Root=rootPart};

	for _, part in pairs(character:GetChildren()) do 
		if part:IsA("BasePart") then 
			map[part.Name]=part;
		end 
	end 

	return map 
end 

function IsCharacterValid(char,hum)
	return char and hum and hum.Health > (.and.Settings.Aimbot.IgnoreDownedPlayers)or-.and not hum.Sit or hum.PlatformStanding 
end 

function DistanceFromCamera(part)
	return(part.Position-Camera.CFrame.Position).Magnitude 
end 

